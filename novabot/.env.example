# --- Identite du bot ---
BOT_NAME=NOVA
# Ton prenom/nom : le clone "signe" ton style sous ce nom
OWNER_NAME=moi
PREFIX=.
# Ton numero proprietaire, sans + (plusieurs separes par virgule)
OWNERS=237000000000

# --- Connexion ---
PAIRING_NUMBER=
SHOW_QR=true
SESSION_DIR=session
PROCESS_OWN=false

# --- IA ---
# Fournisseur: 'ollama' (LOCAL, gratuit, sans cle) ou 'anthropic'
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
# Modele local (a telecharger: ollama pull <modele>)
AI_MODEL=qwen2.5:7b
# Si tu passes a anthropic: mets la cle ici et LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

AI_AUTOREPLY=false
# Clone de style : repond A TA PLACE, par personne, en gardant le contexte
PERSONA_CLONE=false
HISTORY_LIMIT=30
