# === OBLIGATOIRE ===
# Cle API Anthropic — https://console.anthropic.com/ (Settings > API Keys)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Token d'authentification Twilio (pour valider que les webhooks viennent bien de Twilio)
# Console Twilio > Account Info > Auth Token
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# === OPTIONNEL ===
# Modele Claude. Rapide et economique : claude-haiku-5-5
# Plus capable : claude-sonnet-5-5
CLAUDE_MODEL=claude-haiku-5-5

# Mettre "false" UNIQUEMENT pour des tests sans verif de signature (deconseille)
VALIDATE_TWILIO=true

# Voix de synthese pour les appels (voix francaises Amazon Polly) :
#   Polly.Lea-Neural (F), Polly.Remi-Neural (H), Polly.Celine, Polly.Mathieu
TTS_VOICE=Polly.Lea-Neural
TTS_LANG=fr-FR

# Port du serveur local
PORT=3000

# Personnalite / consignes (decommente pour personnaliser)
# SYSTEM_PROMPT=Tu es Claude, un assistant joignable par telephone...
